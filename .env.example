# Persistence adapter: mock (localStorage, works offline) | http (needs the RTT-api milestone)
VITE_DATA_SOURCE=mock

# Dictation engine: webspeech (live microphone) | replay (cached Hinglish take for demos and CI).
# Overridable at runtime in Settings, which stores the choice in localStorage.
VITE_TRANSCRIBE=webspeech

# Base URL of the API, used only when VITE_DATA_SOURCE=http
# VITE_API_URL=http://localhost:4000

# Firebase Web Push. Copy the web app config from Firebase console -> Project settings
# -> General, and the VAPID key from Project settings -> Cloud Messaging -> Web Push
# certificates. Keep the real values in .env.local; these placeholders are committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
